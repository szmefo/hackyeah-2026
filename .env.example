# Run the Python engine locally on port 8000, or use the separate Vercel engine.
ENGINE_URL=http://127.0.0.1:8000
# Generate a random secret and set the SAME value in Next and engine processes.
ENGINE_SHARED_SECRET=
# Optional AI, set only in Next/Vercel server settings. Never expose to browsers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
# Future storage integration, not active:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Never put server secrets into NEXT_PUBLIC_ variables.
